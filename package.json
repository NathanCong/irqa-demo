{
  "name": "irqa-demo",
  "version": "1.0.0",
  "description": "机器人智能问答DEMO",
  "main": "src/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make:win32": "electron-forge make --platform=win32",
    "make:linux": "electron-forge make --platform=linux",
